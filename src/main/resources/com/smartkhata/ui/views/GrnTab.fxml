<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smartkhata.controller.GrnController"
      spacing="14.0" style="-fx-padding: 14 0 0 0;">

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <TextField fx:id="txtGrnSearch" promptText="Search GRN#, PO#, challan, or supplier..." onKeyReleased="#onSearch"
                   HBox.hgrow="ALWAYS"
                   style="-fx-pref-height: 36px; -fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 12;"/>
        <ComboBox fx:id="cmbGrnStatus" onAction="#onFilterChanged" prefWidth="150.0"
                  style="-fx-pref-height: 36px; -fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8;"/>
        <Button text="Refresh" onAction="#onRefresh"
                style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-pref-height: 36px; -fx-padding: 0 14; -fx-cursor: hand; -fx-font-weight: 600;"/>
        <Button fx:id="btnNewGrnFromPo" text="+ Receive from PO (GRN)" onAction="#onReceiveFromPo"
                style="-fx-background-color: #0E7B3A; -fx-text-fill: white; -fx-font-weight: 700; -fx-pref-height: 36px; -fx-padding: 0 15; -fx-background-radius: 8; -fx-cursor: hand;"/>
        <Button fx:id="btnNewDirectGrn" text="+ Direct GRN" onAction="#onDirectGrn"
                style="-fx-background-color: #ECFDF5; -fx-text-fill: #0E7B3A; -fx-font-weight: 700; -fx-border-color: #86EFAC; -fx-border-radius: 8; -fx-pref-height: 36px; -fx-padding: 0 14; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>

    <HBox spacing="14.0" VBox.vgrow="ALWAYS">
        <VBox spacing="10.0" HBox.hgrow="ALWAYS" styleClass="sk-card">
            <TableView fx:id="tblGrns" VBox.vgrow="ALWAYS" styleClass="table-view, compact-table">
                <columns>
                    <TableColumn fx:id="colGrnNumber" text="GRN #" prefWidth="135.0"/>
                    <TableColumn fx:id="colGrnDate" text="Receipt Date" prefWidth="115.0"/>
                    <TableColumn fx:id="colGrnPo" text="PO Reference" prefWidth="125.0"/>
                    <TableColumn fx:id="colGrnSupplier" text="Supplier" prefWidth="165.0"/>
                    <TableColumn fx:id="colGrnQty" text="Accepted / Reject" prefWidth="105.0"/>
                    <TableColumn fx:id="colGrnTotal" text="Landed Cost" prefWidth="110.0"/>
                    <TableColumn fx:id="colGrnStatus" text="Status" prefWidth="95.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <VBox alignment="CENTER" spacing="8.0" style="-fx-padding: 40px;">
                        <Label text="No Goods Receipt Notes (GRN) posted yet" style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #64748B;"/>
                        <Label text="Receive stock from a Confirmed PO or post an authorized Direct GRN to update inventory and weighted average cost."
                               style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;"/>
                    </VBox>
                </placeholder>
            </TableView>
        </VBox>

        <VBox prefWidth="520.0" minWidth="440.0" maxWidth="600.0" spacing="12.0" styleClass="sk-card">
            <VBox fx:id="vboxGrnNoSelection" alignment="CENTER" spacing="10.0" VBox.vgrow="ALWAYS" style="-fx-padding: 50 20;">
                <Label text="Select a GRN Record" style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #64748B;"/>
                <Label text="Inspect accepted vs rejected/damaged quantities, unit conversions, freight allocation, and weighted average cost impact."
                       textAlignment="CENTER" wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;"/>
            </VBox>

            <VBox fx:id="vboxGrnDetail" spacing="10.0" VBox.vgrow="ALWAYS" visible="false" managed="false">
                <VBox spacing="3.0">
                    <Label fx:id="lblDetailGrnNo" text="GRN-20261110-0001" style="-fx-font-size: 17px; -fx-font-weight: 800; -fx-text-fill: #0F172A;"/>
                    <Label fx:id="lblDetailGrnMeta" text="Supplier: — | PO: —" wrapText="true" style="-fx-font-size: 11.5px; -fx-text-fill: #64748B;"/>
                    <Label fx:id="lblDetailGrnReversal" text="" wrapText="true" visible="false" managed="false"
                           style="-fx-font-size: 11.5px; -fx-font-weight: 700; -fx-text-fill: #991B1B; -fx-background-color: #FEF2F2; -fx-padding: 5 8; -fx-background-radius: 6;"/>
                </VBox>

                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Button fx:id="btnReverseGrn" text="Reverse GRN (Owner)" onAction="#onReverseGrn"
                            style="-fx-background-color: #FEF2F2; -fx-text-fill: #DC2626; -fx-font-weight: 700; -fx-border-color: #FECACA; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand;"/>
                </HBox>

                <HBox spacing="12.0" alignment="CENTER"
                      style="-fx-background-color: #F8FAFC; -fx-padding: 8 12; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
                    <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                        <Label text="SUBTOTAL" style="-fx-font-size: 9.5px; -fx-font-weight: 700; -fx-text-fill: #64748B;"/>
                        <Label fx:id="lblDetailSubtotal" text="BDT 0" style="-fx-font-size: 13px; -fx-font-weight: 800; -fx-text-fill: #0F172A;"/>
                    </VBox>
                    <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                        <Label text="FREIGHT / EXTRA" style="-fx-font-size: 9.5px; -fx-font-weight: 700; -fx-text-fill: #64748B;"/>
                        <Label fx:id="lblDetailFreight" text="BDT 0" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #475569;"/>
                    </VBox>
                    <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                        <Label text="TOTAL LANDED COST" style="-fx-font-size: 9.5px; -fx-font-weight: 700; -fx-text-fill: #15803D;"/>
                        <Label fx:id="lblDetailTotalCost" text="BDT 0" style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: #15803D;"/>
                    </VBox>
                </HBox>

                <TableView fx:id="tblGrnItems" VBox.vgrow="ALWAYS" styleClass="table-view, compact-table">
                    <columns>
                        <TableColumn fx:id="colGiProduct" text="Product" prefWidth="140.0"/>
                        <TableColumn fx:id="colGiQty" text="Acc / Rej / Dmg" prefWidth="95.0"/>
                        <TableColumn fx:id="colGiBaseQty" text="Stock Added" prefWidth="82.0"/>
                        <TableColumn fx:id="colGiUnitCost" text="Eff. Cost" prefWidth="76.0"/>
                        <TableColumn fx:id="colGiTotal" text="Line Cost" prefWidth="86.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>
    </HBox>
</VBox>

