<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<ScrollPane fitToWidth="true" stylesheets="@../css/styles.css"
            style="-fx-background-color: transparent; -fx-background: -color-surface-bg;"
            prefHeight="760.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartkhata.controller.OnboardingWizardController">

    <StackPane style="-fx-padding: 30 20;">
        <VBox alignment="CENTER" spacing="20" maxWidth="520.0">
            <!-- App Header -->
            <HBox alignment="CENTER" spacing="12">
                <StackPane prefWidth="44" prefHeight="44" style="-fx-background-color: -color-brand-primary; -fx-background-radius: 10;">
                    <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"
                             fill="white" scaleX="0.9" scaleY="0.9" />
                </StackPane>
                <VBox spacing="1">
                    <Label text="SmartKhata" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: -color-brand-primary;" />
                    <Label text="Initial Business &amp; Store Setup Wizard" style="-fx-font-size: 11px; -fx-text-fill: #64748B;" />
                </VBox>
            </HBox>

            <!-- Onboarding Welcome Illustration -->
            <ImageView fitWidth="480.0" preserveRatio="true" smooth="true">
                <Image url="@/assets/onboarding-welcome.png" />
            </ImageView>

            <!-- Error Banner -->
            <Label fx:id="errorLabel" text="Validation Error" wrapText="true"
                   style="-fx-background-color: #FEE2E2; -fx-text-fill: #DC2626; -fx-padding: 8 12; -fx-background-radius: 6; -fx-font-weight: bold; -fx-font-size: 12px;" />

            <!-- STEP 1: Store & Owner Details -->
            <VBox fx:id="stepOnePane" styleClass="sk-card" spacing="16">
                <VBox spacing="2">
                    <Label text="Step 1 of 2: Store &amp; Credential Setup" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #0F172A;" />
                    <Label text="Configure your local business profile and create your master owner credential." style="-fx-font-size: 12px; -fx-text-fill: #64748B;" />
                </VBox>

                <Separator opacity="0.4" />

                <!-- Form Fields -->
                <VBox spacing="6">
                    <Label text="Business / Shop Name *" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;" />
                    <TextField fx:id="businessNameField" promptText="e.g. Mizan Stores / আল-আমিন ট্রেডার্স"
                               style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-pref-height: 38px; -fx-padding: 0 12;" />
                </VBox>

                <HBox spacing="12">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Owner Full Name *" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;" />
                        <TextField fx:id="ownerNameField" promptText="e.g. Mizanur Rahman"
                                   style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-pref-height: 38px; -fx-padding: 0 12;" />
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Username *" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;" />
                        <TextField fx:id="usernameField" text="admin" promptText="Username"
                                   style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-pref-height: 38px; -fx-padding: 0 12;" />
                    </VBox>
                </HBox>

                <HBox spacing="12">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Mobile Number (Optional)" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;" />
                        <TextField fx:id="phoneField" promptText="017XXXXXXXX"
                                   style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-pref-height: 38px; -fx-padding: 0 12;" />
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Interface Language" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;" />
                        <ComboBox fx:id="languageCombo" maxWidth="Infinity" prefHeight="38.0" />
                    </VBox>
                </HBox>

                <VBox spacing="6">
                    <Label text="Shop Address (Optional)" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;" />
                    <TextField fx:id="addressField" promptText="e.g. Chawkbazar, Dhaka"
                               style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-pref-height: 38px; -fx-padding: 0 12;" />
                </VBox>

                <HBox spacing="12">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Set Security PIN / Password *" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;" />
                        <PasswordField fx:id="pinField" promptText="Min 4 characters"
                                       style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-pref-height: 38px; -fx-padding: 0 12;" />
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Confirm PIN / Password *" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;" />
                        <PasswordField fx:id="confirmPinField" promptText="Re-enter PIN"
                                       style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-pref-height: 38px; -fx-padding: 0 12;" />
                    </VBox>
                </HBox>

                <CheckBox fx:id="chkLoadSampleData" text="Load sample grocery catalog &amp; transactions (explore immediately)"
                          selected="true" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: -color-brand-primary; -fx-cursor: hand;" />

                <Button text="Continue to Recovery Code Setup →" onAction="#onProceedToStepTwo"
                        maxWidth="Infinity" prefHeight="44.0"
                        style="-fx-background-color: -color-brand-primary; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand;" />
            </VBox>

            <!-- STEP 2: Offline Master Recovery Code -->
            <VBox fx:id="stepTwoPane" styleClass="sk-card" spacing="16">
                <VBox spacing="4">
                    <Label text="Step 2 of 2: Offline Master Recovery Code" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #0F172A;" />
                    <Label text="SmartKhata is 100% offline. There is no cloud reset email or SMS OTP. Your recovery code is the only way to reset your master PIN if forgotten."
                           wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #64748B;" />
                </VBox>

                <Separator opacity="0.4" />

                <!-- Recovery Code Display Box -->
                <VBox alignment="CENTER" spacing="6"
                      style="-fx-background-color: #EFF6FF; -fx-border-color: #93C5FD; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 16;">
                    <Label text="YOUR OFFLINE MASTER RECOVERY CODE:" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #1E40AF;" />
                    <Label fx:id="recoveryCodeLabel" text="SK-XXXX-XXXX-XXXX-XXXX"
                           style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-font-family: monospace; -fx-text-fill: -color-brand-primary;" />
                    <Label text="Write down this code in a secure ledger or save it on a private USB flash drive." style="-fx-font-size: 11px; -fx-text-fill: #64748B;" />
                </VBox>

                <CheckBox fx:id="recoveryConfirmedCheck" text="I have recorded my offline master recovery code in a safe location."
                          wrapText="true" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />

                <Button text="Complete Setup &amp; Launch SmartKhata" onAction="#onFinishSetup"
                        maxWidth="Infinity" prefHeight="44.0"
                        style="-fx-background-color: -color-brand-success; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand;" />
            </VBox>
        </VBox>
    </StackPane>
</ScrollPane>

