<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smartkhata.controller.PurchaseReturnsController"
      spacing="14.0" style="-fx-padding: 14 0 0 0;">
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Supplier Purchase Returns (সরবরাহকারী পণ্য ফেরত)"
               style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: #0F172A;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refresh" onAction="#onRefresh"
                style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-pref-height: 36px; -fx-padding: 0 14;"/>
        <Button text="+ New Supplier Return" onAction="#onNewReturn"
                style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-weight: 700; -fx-pref-height: 36px; -fx-padding: 0 15; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>

    <VBox VBox.vgrow="ALWAYS" styleClass="sk-card">
        <TableView fx:id="tblReturns" VBox.vgrow="ALWAYS" styleClass="table-view, compact-table">
            <columns>
                <TableColumn fx:id="colRetNumber" text="Return #" prefWidth="140.0"/>
                <TableColumn fx:id="colRetDate" text="Return Date" prefWidth="130.0"/>
                <TableColumn fx:id="colRetSupplier" text="Supplier" prefWidth="190.0"/>
                <TableColumn fx:id="colRetGrn" text="GRN Ref" prefWidth="130.0"/>
                <TableColumn fx:id="colRetAmount" text="Return Amount" prefWidth="120.0"/>
                <TableColumn fx:id="colRetReason" text="Reason" prefWidth="250.0"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>

