                                    <TableColumn fx:id="colMoveType" text="Movement" minWidth="80.0" prefWidth="96.0"/>
                                    <TableColumn fx:id="colMoveQty" text="Qty" minWidth="40.0" prefWidth="48.0" maxWidth="60.0"/>
                                    <TableColumn fx:id="colMoveCost" text="Unit Cost" minWidth="60.0" prefWidth="72.0"/>
                                    <TableColumn fx:id="colMoveNotes" text="Notes" minWidth="75.0" prefWidth="96.0"/>
