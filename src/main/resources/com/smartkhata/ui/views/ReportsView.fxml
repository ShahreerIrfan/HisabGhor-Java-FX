<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smartkhata.controller.ReportsController"
      spacing="16.0" style="-fx-background-color: -color-surface-bg;" styleClass="main-content">
    <padding>
        <Insets top="20.0" right="24.0" bottom="24.0" left="24.0"/>
    </padding>

    <!-- Top Header Bar with Export Actions -->
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <VBox spacing="2.0">
            <Label text="Reports &amp; Financial Statements (হিসাব বিবরণী ও রিপোর্ট খাতা)"
                   style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #1E293B;"/>
            <Label text="Audit-ready financial statements, customer &amp; supplier ledgers, inventory valuation, and exports."
                   style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Export PDF Button -->
        <Button fx:id="btnExportPdf" text=" Export PDF (পিডিএফ)" onAction="#onExportPdf"
                style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 16; -fx-background-radius: 8; -fx-cursor: hand;">
            <graphic>
                <SVGPath content="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"
                         fill="white" scaleX="0.75" scaleY="0.75" />
            </graphic>
        </Button>

        <!-- Export CSV Button -->
        <Button fx:id="btnExportCsv" text=" Export CSV (এক্সেল)" onAction="#onExportCsv"
                style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 16; -fx-background-radius: 8; -fx-cursor: hand;">
            <graphic>
                <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H5v-4h4v4zm0-6H5V7h4v4zm6 6h-4v-4h4v4zm0-6h-4V7h4v4zm6 6h-4v-4h4v4zm0-6h-4V7h4v4z"
                         fill="white" scaleX="0.75" scaleY="0.75" />
            </graphic>
        </Button>

        <!-- Print Action Button -->
        <Button fx:id="btnPrint" text=" Print (প্রিন্ট)" onAction="#onPrint"
                style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-weight: bold; -fx-padding: 8 16; -fx-cursor: hand;">
            <graphic>
                <SVGPath content="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z"
                         fill="#334155" scaleX="0.75" scaleY="0.75" />
            </graphic>
        </Button>
    </HBox>

    <!-- Filter Toolbar -->
    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: white; -fx-padding: 12 16; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
        <Label text="Report:" style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 12px;"/>
        <ComboBox fx:id="cmbReportType" onAction="#onReportTypeChanged"
                  style="-fx-pref-height: 38px; -fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-pref-width: 245px;"/>

        <Label text="Range:" style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 12px;"/>
        <ComboBox fx:id="cmbPeriodPreset" onAction="#onPeriodPresetChanged"
                  style="-fx-pref-height: 38px; -fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-pref-width: 125px;"/>

        <DatePicker fx:id="dpStartDate" promptText="Start Date"
                    style="-fx-pref-height: 38px; -fx-background-color: white; -fx-pref-width: 128px;"/>

        <DatePicker fx:id="dpEndDate" promptText="End Date"
                    style="-fx-pref-height: 38px; -fx-background-color: white; -fx-pref-width: 128px;"/>

        <!-- Party / Category Selector (Shown dynamically for Ledger, Supplier Purchase, or Product Profitability) -->
        <ComboBox fx:id="cmbPartySelector" promptText="Filter Option"
                  style="-fx-pref-height: 38px; -fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-pref-width: 170px;"/>

        <!-- Low Stock Only Checkbox -->
        <CheckBox fx:id="chkLowStockOnly" text="Low Stock Only"
                  style="-fx-font-weight: 600; -fx-text-fill: #64748B; -fx-cursor: hand;"/>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Generate Button -->
        <Button fx:id="btnGenerateReport" text="Generate Statement (রিপোর্ট তৈরি করুন)" onAction="#onGenerateReport"
                style="-fx-background-color: #0E7B3A; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 38px; -fx-padding: 0 18; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>

    <!-- Report Title & Summary Cards Area -->
    <VBox spacing="10.0">
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label fx:id="lblReportTitle" text="Sales Summary Report" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
            <Label fx:id="lblReportPeriod" text="Period: Nov 01, 2026 to Nov 08, 2026" style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
        </HBox>

        <!-- Dynamic Summary Cards HBox -->
        <HBox fx:id="pnlSummaryCards" spacing="14.0"/>
    </VBox>

    <!-- Report Table View -->
    <VBox VBox.vgrow="ALWAYS" styleClass="sk-card" spacing="8.0">
        <TableView fx:id="tblReport" VBox.vgrow="ALWAYS" styleClass="table-view">
            <placeholder>
                <VBox alignment="CENTER" spacing="8.0" style="-fx-padding: 50px;">
                    <Label text="No report generated yet" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #64748B;"/>
                    <Label text="Select a report type and date range above, then click 'Generate Statement'." style="-fx-font-size: 13px; -fx-text-fill: #94A3B8;"/>
                </VBox>
            </placeholder>
        </TableView>
    </VBox>
</VBox>
