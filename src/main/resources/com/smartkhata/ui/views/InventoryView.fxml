                                        <Label text="Opening stock, purchases, sales, and adjustments appear here." style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;"/>
                                    </VBox>
                                </placeholder>
                            </TableView>
                        </VBox>
                    </Tab>
                    <Tab text="Suppliers &amp; TP (সরবরাহকারী)">
