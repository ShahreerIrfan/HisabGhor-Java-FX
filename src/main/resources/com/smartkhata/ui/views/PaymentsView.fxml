<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smartkhata.controller.PaymentsController"
      spacing="16.0" style="-fx-background-color: -color-surface-bg;" styleClass="main-content">
    <padding>
        <Insets top="20.0" right="24.0" bottom="24.0" left="24.0"/>
    </padding>

    <!-- Top Header Bar -->
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <VBox spacing="2.0">
            <Label text="Payments &amp; Collections (টাকা আদায় ও পরিশোধ)"
                   style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #1E293B;"/>
            <Label text="Customer due collections, supplier disbursements, FIFO invoice settlement, and payment vouchers."
                   style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Total Collections Pill -->
        <HBox alignment="CENTER_LEFT" spacing="8.0"
              style="-fx-background-color: #F0FDF4; -fx-padding: 8 16; -fx-background-radius: 8; -fx-border-color: #86EFAC; -fx-border-radius: 8;">
            <Label text="Total Collections (আদায়):" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #166534;"/>
            <Label fx:id="lblTotalCollections" text="BDT 0.00" style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: #15803D;"/>
        </HBox>

        <!-- Total Disbursements Pill -->
        <HBox alignment="CENTER_LEFT" spacing="8.0"
              style="-fx-background-color: #EFF6FF; -fx-padding: 8 16; -fx-background-radius: 8; -fx-border-color: #93C5FD; -fx-border-radius: 8;">
            <Label text="Total Disbursements (পরিশোধ):" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #1E40AF;"/>
            <Label fx:id="lblTotalDisbursements" text="BDT 0.00" style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: #2563EB;"/>
        </HBox>

        <!-- Receive Customer Payment Button -->
        <Button fx:id="btnReceivePayment" text="+ Customer Collection (আদায়)" onAction="#onReceivePayment"
                style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 16; -fx-background-radius: 8; -fx-cursor: hand;"/>

        <!-- Make Supplier Payment Button -->
        <Button fx:id="btnMakePayment" text="- Supplier Payment (পরিশোধ)" onAction="#onMakePayment"
                style="-fx-background-color: #3B82F6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 16; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>

    <!-- Search & Filter Toolbar -->
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <TextField fx:id="txtSearch" promptText="Search payments by voucher number, transaction ID, or party name..."
                   onKeyReleased="#onSearchKeyReleased" HBox.hgrow="ALWAYS" styleClass="search-field"
                   style="-fx-pref-height: 38px; -fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 12;"/>

        <ComboBox fx:id="cmbPartyTypeFilter" promptText="All Parties" onAction="#onFilterChanged"
                  style="-fx-pref-height: 38px; -fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-pref-width: 140px;"/>

        <ComboBox fx:id="cmbMethodFilter" promptText="All Methods" onAction="#onFilterChanged"
                  style="-fx-pref-height: 38px; -fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-pref-width: 140px;"/>

        <Button fx:id="btnRefresh" text="Refresh" onAction="#onRefresh"
                style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-pref-height: 38px; -fx-padding: 0 16; -fx-cursor: hand;"/>
    </HBox>

    <!-- Main Content Area: Table & Detail -->
    <HBox spacing="16.0" VBox.vgrow="ALWAYS">

        <!-- Left Table: Payments List -->
        <VBox spacing="12.0" HBox.hgrow="ALWAYS" styleClass="sk-card">
            <TableView fx:id="tblPayments" VBox.vgrow="ALWAYS" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colPaymentNo" text="Voucher No" prefWidth="140.0"/>
                    <TableColumn fx:id="colDate" text="Date &amp; Time" prefWidth="130.0"/>
                    <TableColumn fx:id="colPartyType" text="Type" prefWidth="95.0"/>
                    <TableColumn fx:id="colPartyName" text="Party Name" prefWidth="170.0"/>
                    <TableColumn fx:id="colMethod" text="Method" prefWidth="90.0"/>
                    <TableColumn fx:id="colAmount" text="Amount" prefWidth="110.0"/>
                    <TableColumn fx:id="colReference" text="Trx Ref" prefWidth="110.0"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="85.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <VBox alignment="CENTER" spacing="8.0" style="-fx-padding: 40px;">
                        <Label text="No payment records found" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #64748B;"/>
                        <Label text="Click '+ Customer Collection' or '- Supplier Payment' to record transactions." style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;"/>
                    </VBox>
                </placeholder>
            </TableView>
        </VBox>

        <!-- Right Panel: Payment Detail & Voucher -->
        <VBox fx:id="pnlDetailContainer" prefWidth="520.0" minWidth="440.0" maxWidth="600.0" spacing="14.0" styleClass="sk-card">

            <!-- Empty State Placeholder when no payment is selected -->
            <VBox fx:id="vboxNoSelection" alignment="CENTER" spacing="12.0" VBox.vgrow="ALWAYS" style="-fx-padding: 60px 20px;">
                <Label text="Select a Payment Voucher" style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #64748B;"/>
                <Label text="Select a payment from the table to view settled invoices, payment method details, and print voucher."
                       textAlignment="CENTER" wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;"/>
            </VBox>

            <!-- Active Payment Detail View -->
            <VBox fx:id="vboxPaymentDetails" spacing="12.0" VBox.vgrow="ALWAYS" visible="false" managed="false">

                <!-- Header & Actions -->
                <VBox spacing="8.0">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblDetailPaymentNo" text="PAY-C-20261108-0001"
                                   style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #0F172A;"/>
                            <Label fx:id="lblDetailPartyInfo" text="Party: Rahim Traders | Date: —"
                                   style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                            <Label fx:id="lblDetailNotes" text="" wrapText="true" visible="false" managed="false"
                                   style="-fx-font-size: 11.5px; -fx-text-fill: #475569; -fx-font-style: italic;"/>
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Button fx:id="btnEditPayment" text="Edit Details" onAction="#onEditPayment"
                                style="-fx-background-color: #EFF6FF; -fx-text-fill: #1D4ED8; -fx-font-weight: bold; -fx-border-color: #BFDBFE; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand;"/>

                        <Button fx:id="btnPrintVoucher" text="Print Voucher" onAction="#onPrintVoucher"
                                style="-fx-background-color: #F1F5F9; -fx-text-fill: #1E293B; -fx-font-weight: bold; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand;"/>

                        <Button fx:id="btnVoidPayment" text="Void Payment" onAction="#onVoidPayment"
                                style="-fx-background-color: #FEF2F2; -fx-text-fill: #DC2626; -fx-font-weight: bold; -fx-border-color: #FECACA; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand;"/>

                        <Button fx:id="btnDeleteVoidedPayment" text="Delete Voided" onAction="#onDeleteVoidedPayment"
                                visible="false" managed="false"
                                style="-fx-background-color: #FEE2E2; -fx-text-fill: #B91C1C; -fx-font-weight: bold; -fx-border-color: #FCA5A5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <!-- Amount & Method Banner -->
                <HBox spacing="14.0" alignment="CENTER"
                      style="-fx-background-color: #F8FAFC; -fx-padding: 10 14; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label text="PAID AMOUNT" style="-fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #64748B;"/>
                        <Label fx:id="lblDetailAmount" text="BDT 0.00" style="-fx-font-size: 17px; -fx-font-weight: 800; -fx-text-fill: #1E293B;"/>
                    </VBox>
                    <Separator orientation="VERTICAL"/>
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label text="METHOD" style="-fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #64748B;"/>
                        <Label fx:id="lblDetailMethod" text="CASH" style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #2563EB;"/>
                    </VBox>
                    <Separator orientation="VERTICAL"/>
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label text="TRX REFERENCE" style="-fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #64748B;"/>
                        <Label fx:id="lblDetailTrxRef" text="—" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                    </VBox>
                </HBox>

                <!-- Allocations Table -->
                <Label text="Settled Invoices / Bills (FIFO Allocation)" style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #1E293B;"/>
                <TableView fx:id="tblDetailAllocations" VBox.vgrow="ALWAYS" styleClass="table-view">
                    <columns>
                        <TableColumn fx:id="colAllocType" text="Type" prefWidth="110.0"/>
                        <TableColumn fx:id="colAllocRef" text="Invoice / Bill No" prefWidth="180.0"/>
                        <TableColumn fx:id="colAllocAmount" text="Allocated Amount" prefWidth="130.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <!-- Reversal / Void Warning Banner if reversed -->
                <Label fx:id="lblVoidStatus" text="VOIDED: Reason" visible="false" managed="false"
                       style="-fx-background-color: #FEF2F2; -fx-text-fill: #991B1B; -fx-font-weight: bold; -fx-padding: 8 12; -fx-background-radius: 6; -fx-border-color: #F87171; -fx-border-radius: 6;"/>
            </VBox>

        </VBox>
    </HBox>
</VBox>

