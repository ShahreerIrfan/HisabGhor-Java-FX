<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smartkhata.controller.PurchasesController"
      spacing="16.0" style="-fx-background-color: -color-surface-bg;" styleClass="main-content">
    <padding>
        <Insets top="20.0" right="24.0" bottom="24.0" left="24.0"/>
    </padding>

    <!-- Top Header Bar -->
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <VBox spacing="2.0">
            <Label text="Procurement, PO, GRN &amp; Purchases (ক্রয় ও প্রকিউরমেন্ট খাতা)"
                   style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #0F172A;"/>
            <Label text="Manage Purchase Orders, Goods Receipts (GRN), Supplier Invoices &amp; Direct Bills."
                   style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Total Bills Pill -->
        <HBox alignment="CENTER_LEFT" spacing="8.0"
              style="-fx-background-color: #FFFFFF; -fx-padding: 8 16; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
            <Label text="Direct Bills:" style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
            <Label fx:id="lblTotalBills" text="0" style="-fx-font-size: 13px; -fx-font-weight: 800; -fx-text-fill: #1E293B;"/>
        </HBox>

        <!-- Outstanding Payables Pill -->
        <HBox alignment="CENTER_LEFT" spacing="8.0"
              style="-fx-background-color: #FEF2F2; -fx-padding: 8 16; -fx-background-radius: 8; -fx-border-color: #FCA5A5; -fx-border-radius: 8;">
            <Label text="Total Payables (মহাজন দেনা):" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #991B1B;"/>
            <Label fx:id="lblTotalPayables" text="BDT 0.00" style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: #DC2626;"/>
        </HBox>

        <!-- Net Purchased Amount Pill -->
        <HBox alignment="CENTER_LEFT" spacing="8.0"
              style="-fx-background-color: #F0FDF4; -fx-padding: 8 16; -fx-background-radius: 8; -fx-border-color: #86EFAC; -fx-border-radius: 8;">
            <Label text="Total Purchases:" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #166534;"/>
            <Label fx:id="lblTotalPurchases" text="BDT 0.00" style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: #15803D;"/>
        </HBox>

        <!-- New Purchase Button -->
        <Button fx:id="btnNewPurchase" text="+ Quick Direct Bill (ক্রয় চালান)" onAction="#onNewPurchase"
                style="-fx-background-color: -color-brand-primary; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 18; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>

    <!-- Procurement Workflow Tabs -->
    <TabPane fx:id="procurementTabPane" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: transparent;">
        <Tab text="Purchase Orders (PO)">
            <fx:include fx:id="poTab" source="PurchaseOrdersTab.fxml"/>
        </Tab>
        <Tab text="Goods Receipts (GRN)">
            <fx:include fx:id="grnTab" source="GrnTab.fxml"/>
        </Tab>
        <Tab text="Supplier Invoices &amp; 3-Way Match">
            <fx:include fx:id="invTab" source="SupplierInvoicesTab.fxml"/>
        </Tab>
        <Tab text="Supplier Returns">
            <fx:include fx:id="returnsTab" source="PurchaseReturnsTab.fxml"/>
        </Tab>
        <Tab text="Direct Bills (তাৎক্ষণিক ক্রয়)">
            <VBox spacing="12.0" style="-fx-padding: 14 0 0 0;">

    <!-- Search & Filter Toolbar -->
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <TextField fx:id="txtSearch" promptText="Search purchases by bill number or supplier name..."
                   onKeyReleased="#onSearchKeyReleased" HBox.hgrow="ALWAYS" styleClass="search-field"
                   style="-fx-pref-height: 38px; -fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 12;"/>

        <ComboBox fx:id="cmbStatusFilter" promptText="All Statuses" onAction="#onStatusFilterChanged"
                  style="-fx-pref-height: 38px; -fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-pref-width: 150px;"/>

        <Button fx:id="btnRefresh" text="Refresh" onAction="#onRefresh"
                style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-pref-height: 38px; -fx-padding: 0 16; -fx-cursor: hand;"/>
    </HBox>

    <!-- Main Content Area: Split List & Detail -->
    <HBox spacing="16.0" VBox.vgrow="ALWAYS">

        <!-- Left Table: Purchases List -->
        <VBox spacing="12.0" HBox.hgrow="ALWAYS" styleClass="sk-card">
            <TableView fx:id="tblPurchases" VBox.vgrow="ALWAYS" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colPurchaseNo" text="Purchase No" prefWidth="150.0"/>
                    <TableColumn fx:id="colDate" text="Date &amp; Time" prefWidth="130.0"/>
                    <TableColumn fx:id="colSupplier" text="Supplier" prefWidth="160.0"/>
                    <TableColumn fx:id="colAmount" text="Net Amount" prefWidth="110.0"/>
                    <TableColumn fx:id="colPaid" text="Paid" prefWidth="100.0"/>
                    <TableColumn fx:id="colDue" text="Due (দেনা)" prefWidth="110.0"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="95.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <VBox alignment="CENTER" spacing="8.0" style="-fx-padding: 40px;">
                        <Label text="No purchase records found" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #64748B;"/>
                        <Label text="Click '+ New Purchase (ক্রয় চালান)' to record inbound stock from suppliers." style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;"/>
                    </VBox>
                </placeholder>
            </TableView>
        </VBox>

        <!-- Right Panel: Purchase Detail -->
        <VBox fx:id="pnlDetailContainer" prefWidth="540.0" minWidth="450.0" maxWidth="620.0" spacing="14.0" styleClass="sk-card">

            <!-- Empty State Placeholder when no bill is selected -->
            <VBox fx:id="vboxNoSelection" alignment="CENTER" spacing="12.0" VBox.vgrow="ALWAYS" style="-fx-padding: 60px 20px;">
                <Label text="Select a Purchase Bill" style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #64748B;"/>
                <Label text="Select a purchase bill from the table to view line items, supplier information, and audit details."
                       textAlignment="CENTER" wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;"/>
            </VBox>

            <!-- Active Purchase Detail View -->
            <VBox fx:id="vboxPurchaseDetails" spacing="12.0" VBox.vgrow="ALWAYS" visible="false" managed="false">

                <!-- Header & Actions -->
                <VBox spacing="8.0">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblDetailPurchaseNo" text="PUR-20261108-0001"
                                   style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #0F172A;"/>
                            <Label fx:id="lblDetailSupplierInfo" text="Supplier: Meghna Traders | Date: —"
                                   style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                            <Label fx:id="lblDetailNotes" text="" wrapText="true" visible="false" managed="false"
                                   style="-fx-font-size: 11.5px; -fx-text-fill: #475569; -fx-font-style: italic;"/>
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Button fx:id="btnEditPurchaseNote" text="Edit Note" onAction="#onEditPurchaseNote"
                                style="-fx-background-color: #EFF6FF; -fx-text-fill: #1D4ED8; -fx-font-weight: bold; -fx-border-color: #BFDBFE; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand;"/>

                        <Button fx:id="btnPrintBill" text="Print Bill" onAction="#onPrintBill"
                                style="-fx-background-color: #F1F5F9; -fx-text-fill: #1E293B; -fx-font-weight: bold; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand;"/>

                        <Button fx:id="btnVoidPurchase" text="Void Bill" onAction="#onVoidPurchase"
                                style="-fx-background-color: #FEF2F2; -fx-text-fill: #DC2626; -fx-font-weight: bold; -fx-border-color: #FECACA; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand;"/>

                        <Button fx:id="btnDeleteVoidedPurchase" text="Delete Voided" onAction="#onDeleteVoidedPurchase"
                                visible="false" managed="false"
                                style="-fx-background-color: #FEE2E2; -fx-text-fill: #B91C1C; -fx-font-weight: bold; -fx-border-color: #FCA5A5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <!-- Financial Status Banner -->
                <HBox spacing="14.0" alignment="CENTER"
                      style="-fx-background-color: #F8FAFC; -fx-padding: 10 14; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label text="NET AMOUNT" style="-fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #64748B;"/>
                        <Label fx:id="lblDetailNet" text="BDT 0.00" style="-fx-font-size: 16px; -fx-font-weight: 800; -fx-text-fill: #1E293B;"/>
                    </VBox>
                    <Separator orientation="VERTICAL"/>
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label text="PAID AMOUNT" style="-fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #64748B;"/>
                        <Label fx:id="lblDetailPaid" text="BDT 0.00" style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #15803D;"/>
                    </VBox>
                    <Separator orientation="VERTICAL"/>
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label text="DUE (দেনা)" style="-fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #64748B;"/>
                        <Label fx:id="lblDetailDue" text="BDT 0.00" style="-fx-font-size: 15px; -fx-font-weight: 800; -fx-text-fill: #DC2626;"/>
                    </VBox>
                </HBox>

                <!-- Line Items Table -->
                <Label text="Purchased Line Items" style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #1E293B;"/>
                <TableView fx:id="tblDetailItems" VBox.vgrow="ALWAYS" styleClass="table-view">
                    <columns>
                        <TableColumn fx:id="colItemProduct" text="Product" prefWidth="180.0"/>
                        <TableColumn fx:id="colItemQty" text="Qty" prefWidth="60.0"/>
                        <TableColumn fx:id="colItemCost" text="Unit Cost" prefWidth="90.0"/>
                        <TableColumn fx:id="colItemTotal" text="Total" prefWidth="100.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <!-- Reversal / Void Warning Banner if reversed -->
                <Label fx:id="lblVoidStatus" text="VOIDED: Reason" visible="false" managed="false"
                       style="-fx-background-color: #FEF2F2; -fx-text-fill: #991B1B; -fx-font-weight: bold; -fx-padding: 8 12; -fx-background-radius: 6; -fx-border-color: #F87171; -fx-border-radius: 6;"/>
            </VBox>

        </VBox>
    </HBox>
            </VBox>
        </Tab>
    </TabPane>
</VBox>

